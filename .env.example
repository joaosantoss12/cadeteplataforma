# Supabase Configuration
# Copia este ficheiro para .env e preenche com os teus valores do Supabase

VITE_SUPABASE_URL=https://teu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=tua-anon-key-aqui

# Stripe (não precisas de adicionar ao .env local — as chaves secretas ficam
# nas "Edge Function Secrets" do Supabase. Só o frontend não precisa de chaves Stripe.)
# Consulta o README_STRIPE.md para o guia de configuração completo.

# Email da Análise Premium (Resend) — configurar nas "Edge Function Secrets" do Supabase:
#   supabase secrets set RESEND_API_KEY=re_xxxxxxxx
#   supabase secrets set PREMIUM_EMAIL_FROM="Cadete <analises@teu-dominio.com>"
# RESEND_API_KEY: chave da API do Resend (https://resend.com/api-keys).
# PREMIUM_EMAIL_FROM: remetente. Tem de usar um domínio verificado no Resend;
#   sem domínio verificado usa o default "onboarding@resend.dev".
